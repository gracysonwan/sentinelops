      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (application) (rate(jvm_gc_pause_seconds_sum{application=~\"order-service|payment-service|inventory-service|payment-standby\"}[30s])) * 1000",
          "legendFormat": "{{application}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
